{
  "info": {
    "name": "Mini-IBE",
    "description": "Flight booking training service. There are no scripts: send each request yourself and copy values from one response into the next request by hand (flightId into the booking body, reference into the payment URL, totalAmount and currency into the payment body). The collection variables baseUrl, flightId, reference, totalAmount and currency can be edited in the collection's Variables tab. Start the app first (./gradlew bootRun).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/etraveli"
    },
    {
      "key": "flightId",
      "value": "1"
    },
    {
      "key": "reference",
      "value": ""
    },
    {
      "key": "totalAmount",
      "value": ""
    },
    {
      "key": "currency",
      "value": "EUR"
    }
  ],
  "item": [
    {
      "name": "1. Flights",
      "item": [
        {
          "name": "Search flights (sorted by price)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights?origin=ATH&destination=LON&passengers=2&sortBy=price&sortDir=asc&page=0&size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights"
              ],
              "query": [
                {
                  "key": "origin",
                  "value": "ATH"
                },
                {
                  "key": "destination",
                  "value": "LON"
                },
                {
                  "key": "passengers",
                  "value": "2"
                },
                {
                  "key": "sortBy",
                  "value": "price"
                },
                {
                  "key": "sortDir",
                  "value": "asc"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Search flights (price range and date, optional filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights?origin=ATH&minPrice=100&maxPrice=250&sortBy=price&sortDir=desc&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights"
              ],
              "query": [
                {
                  "key": "origin",
                  "value": "ATH"
                },
                {
                  "key": "destination",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "departureDate",
                  "value": "2026-10-19",
                  "disabled": true
                },
                {
                  "key": "minPrice",
                  "value": "100"
                },
                {
                  "key": "maxPrice",
                  "value": "250"
                },
                {
                  "key": "sortBy",
                  "value": "price"
                },
                {
                  "key": "sortDir",
                  "value": "desc"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get flight by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/{{flightId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "{{flightId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Book",
      "item": [
        {
          "name": "Create booking (2 passengers)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": {{flightId}},\n  \"contactEmail\": \"alex@example.com\",\n  \"passengers\": [\n    {\n      \"firstName\": \"Alex\",\n      \"lastName\": \"Papadopoulos\",\n      \"dateOfBirth\": \"1990-04-12\",\n      \"passportNumber\": \"AB123456\"\n    },\n    {\n      \"firstName\": \"Maria\",\n      \"lastName\": \"Papadopoulou\",\n      \"dateOfBirth\": \"1992-09-30\",\n      \"passportNumber\": \"CD654321\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            }
          }
        },
        {
          "name": "Get booking (status CREATED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}"
              ]
            }
          }
        },
        {
          "name": "List bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings?contactEmail=alex@example.com&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "CREATED",
                  "disabled": true
                },
                {
                  "key": "contactEmail",
                  "value": "alex@example.com"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Pay",
      "item": [
        {
          "name": "Pay booking (amount too low, declined)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1.00,\n  \"currency\": \"{{currency}}\",\n  \"cardNumber\": \"4242424242424242\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Pay booking (full amount, approved)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{totalAmount}},\n  \"currency\": \"{{currency}}\",\n  \"cardNumber\": \"4242424242424242\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}",
                "payments"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Review and cancel",
      "item": [
        {
          "name": "Get booking (after payment, status CONFIRMED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}"
              ]
            }
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Negative cases (run last)",
      "item": [
        {
          "name": "Pay a cancelled booking (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{totalAmount}},\n  \"currency\": \"{{currency}}\",\n  \"cardNumber\": \"4242424242424242\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Unknown booking (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/ZZZZZZ",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "ZZZZZZ"
              ]
            }
          }
        },
        {
          "name": "Unknown flight (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights",
                "9999"
              ]
            }
          }
        },
        {
          "name": "Page size too large (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights?size=1000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "flights"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "1000"
                }
              ]
            }
          }
        },
        {
          "name": "Invalid booking body (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": {{flightId}},\n  \"contactEmail\": \"not-an-email\",\n  \"passengers\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            }
          }
        },
        {
          "name": "More passengers than seats (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": 9,\n  \"contactEmail\": \"alex@example.com\",\n  \"passengers\": [\n    {\n      \"firstName\": \"P\",\n      \"lastName\": \"One\",\n      \"dateOfBirth\": \"1990-01-01\",\n      \"passportNumber\": \"PASS0001\"\n    },\n    {\n      \"firstName\": \"P\",\n      \"lastName\": \"Two\",\n      \"dateOfBirth\": \"1990-01-02\",\n      \"passportNumber\": \"PASS0002\"\n    },\n    {\n      \"firstName\": \"P\",\n      \"lastName\": \"Three\",\n      \"dateOfBirth\": \"1990-01-03\",\n      \"passportNumber\": \"PASS0003\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "description": "Uses flight id 9 from the fresh seed data (a flight with only 2 seats left) and asks for 3 seats."
          }
        }
      ]
    }
  ]
}
